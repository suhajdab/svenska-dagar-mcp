{
  "name": "@onereason/svenska-dagar-mcp",
  "version": "0.1.2",
  "description": "MCP server for the Swedish public holiday and calendar API (sholiday.faboul.se)",
  "keywords": [
    "mcp",
    "swedish",
    "calendar",
    "holidays",
    "namnsdagar"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "svenska-dagar-mcp": "dist/server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suhajdab/svenska-dagar-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && chmod 755 dist/server.js",
    "prepublishOnly": "npm run build",
    "start": "node dist/server.js",
    "test": "node --experimental-strip-types --test test/unit.test.ts test/sanitize.test.ts test/api.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "typescript": "6.0.3"
  }
}
